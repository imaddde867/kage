# Kage — Environment Configuration
# Copy this file to .env and adjust values as needed.

# -------------------------------
# LLM backend
# -------------------------------
# Supported:
#   mlx          — in-process text-only model via MLX-LM (default, recommended)
#   mlx_vlm      — in-process VLM via MLX-VLM (for multimodal checkpoints only)
#   openai_compat — external OpenAI-compatible server (e.g. llama.cpp, mlx_lm.server)
LLM_BACKEND=mlx
# Active LLM model (switch this value to swap models):
#   - mlx-community/Qwen3-8B-4bit          ← default; ~Q4_K_M quality, best balance
#   - mlx-community/Qwen3-4B-4bit          fast, lighter RAM footprint
#   - mlx-community/Qwen3-14B-4bit         higher quality, ~2x slower
#   - mlx-community/Qwen3-32B-4bit         best quality, needs 24 GB+ unified memory
MLX_MODEL=mlx-community/Qwen3-8B-4bit
# Optional draft model for speculative decoding (LLM_BACKEND=mlx only).
# Use a same-family smaller checkpoint for ~1.4x throughput boost:
#   MLX_DRAFT_MODEL=mlx-community/Qwen3-0.6B-4bit  # ~1.4x speedup on M-series
# Leave empty to disable speculative decoding (default).
MLX_DRAFT_MODEL=
MLX_MAX_TOKENS=160
TEMPERATURE=0.0

# OpenAI-compatible server (only used when LLM_BACKEND=openai_compat)
# Start server: mlx_lm.server --model mlx-community/Qwen2.5-7B-Instruct-4bit --port 8080
# LLM_BASE_URL=http://localhost:8080/v1
# LLM_API_KEY=none

# -------------------------------
# Wake word
# -------------------------------
# Built-in openwakeword model (auto-downloaded on first run):
#   WAKE_WORD=hey jarvis
#   WAKE_WORD_MODEL=hey_jarvis
# Custom trained model (from openwakeword-training/):
#   WAKE_WORD=hey kage
#   WAKE_WORD_MODEL=./models/hey_kage.onnx
WAKE_WORD=hey kage
WAKE_WORD_MODEL=./models/hey_kage.onnx
WAKE_WORD_THRESHOLD=0.5

# -------------------------------
# STT
# -------------------------------
# apple    = macOS SpeechRecognition (default, no extra deps)
# whisper  = mlx-whisper on Apple Silicon GPU (pip install mlx-whisper)
# parakeet = Parakeet V3 via nano-parakeet — ~5x faster than Whisper on M-series
#            (pip install nano-parakeet)
STT_BACKEND=apple
WHISPER_MODEL=base
# Experimental: emit partial transcripts while listening in voice mode.
# TODO: not yet wired at runtime — setting this to true has no effect.
STT_STREAMING_ENABLED=false
STT_STREAM_INTERVAL_SECONDS=0.8
STT_STREAM_MIN_CHARS=6

# -------------------------------
# TTS (Kokoro via mlx-audio)
# -------------------------------
KOKORO_MODEL=mlx-community/Kokoro-82M-bf16
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0
KOKORO_LANG_CODE=en-us

# -------------------------------
# Memory
# -------------------------------
MEMORY_DIR=./data/memory
RECENT_TURNS=0

# -------------------------------
# Identity
# -------------------------------
USER_NAME=Imad
ASSISTANT_NAME=Kage

# Keep display name as ASSISTANT_NAME, but force spoken pronunciation.
TTS_NAME_OVERRIDE_ENABLED=true
TTS_NAME_PRONUNCIATION=Kah-gay
STT_NAME_NORMALIZATION_ENABLED=true
STT_NAME_VARIANTS=kage,cage,kaj,kaige,kahge,ka-geh

# -------------------------------
# Audio tuning
# -------------------------------
SAMPLE_RATE=16000
WAKE_WORD_CHUNK_SIZE=1280
RECORD_CHUNK_SIZE=1024
SILENCE_THRESHOLD=500
SILENCE_DURATION=1.5
MAX_RECORD_SECONDS=30

# -------------------------------
# Conversation session
# -------------------------------
# After wake-word activation, stay in listen mode until the user is silent for
# this many seconds.  Set to 0 to restore original one-shot behavior (require
# wake word before every prompt).
CONVERSATION_TIMEOUT_SECONDS=45

# -------------------------------
# Turn-taking / barge-in
# -------------------------------
ALLOW_BARGE_IN=true
INTERRUPT_MIN_SCORE=0.55
INTERRUPT_HOLD_MS=220
INTERRUPT_DEBOUNCE_MS=500
POST_TTS_GUARD_MS=250

# -------------------------------
# Text mode
# -------------------------------
TEXT_MODE_TTS_ENABLED=false

# -------------------------------
# Second brain
# -------------------------------
SECOND_BRAIN_ENABLED=false
ENTITY_RECALL_BUDGET=400
PROACTIVE_DEBOUNCE_SECONDS=60
EXTRACTION_ENABLED=false

# -------------------------------
# Agent (tool-using loop)
# -------------------------------
AGENT_ENABLED=false
AGENT_MAX_STEPS=8
AGENT_TEMPERATURE=0.0
AGENT_ENTITY_MODE=relevance_filtered
AGENT_HISTORY_CHAR_BUDGET=8000
AGENT_OBSERVATION_MAX_CHARS=1800
AGENT_TOOL_MAX_RETRIES=1
AGENT_TOOL_RETRY_BACKOFF_SECONDS=0.25
AGENT_TOOL_COOLDOWN_FAILURES=2
AGENT_TOOL_COOLDOWN_SECONDS=15
# AGENT_POLICY_MODE options:
#   strict       — require CLI approval grants before executing any gated tool (default)
#   hybrid       — only gate high_impact tools; moderate_change runs freely
#   owner_fast   — no approval required for any tool
#   interactive  — speak "Do you want me to run X?" and listen for yes/no before
#                  executing shell or mutation tools (voice mode only)
AGENT_POLICY_MODE=strict
SHELL_CONFIRM_TOKEN=YES_I_UNDERSTAND_LOCAL_MUTATION
AGENT_APPROVAL_REQUIRED_TIERS=moderate_change,high_impact
AGENT_AUTONOMY_MAX_HORIZON_STEPS=24
AGENT_REFLECTION_ENABLED=true

# -------------------------------
# Heartbeat (proactive reminders)
# -------------------------------
HEARTBEAT_ENABLED=false
HEARTBEAT_INTERVAL_SECONDS=300

# Do-not-disturb quiet hours (24h clock). Handles overnight windows.
DND_START_HOUR=23
DND_END_HOUR=7

# -------------------------------
# Web fetch TLS behavior
# -------------------------------
WEB_FETCH_TLS_MODE=strict
# Comma-separated trusted domains where insecure fallback is allowed when
# WEB_FETCH_TLS_MODE=allow_insecure_fallback.
WEB_FETCH_INSECURE_FALLBACK_DOMAINS=
# Retry SSL errors once using certifi CA bundle before insecure fallback logic.
WEB_FETCH_TLS_RETRY_WITH_CERTIFI=true

# -------------------------------
# Local artifact tools (read-only)
# -------------------------------
# Comma-separated roots where local file discovery and extraction are allowed.
LOCAL_ARTIFACT_SAFE_ROOTS=./,~
# Comma-separated sensitive roots denied even when they fall under safe roots.
LOCAL_ARTIFACT_DENY_ROOTS=~/.ssh,~/.gnupg,~/.aws,~/.kube,~/Library/Keychains,~/Library/Application Support,/etc,/private,/System,/usr,/bin,/sbin
# Extraction and scan limits.
LOCAL_ARTIFACT_MAX_CHARS=8000
LOCAL_ARTIFACT_MAX_FILE_BYTES=8388608
LOCAL_ARTIFACT_FIND_MAX_FILES=50000

# -------------------------------
# Cron daemon (scheduled reminders)
# -------------------------------
# Polls EntityStore every CRON_POLL_INTERVAL_SECONDS for due scheduled_reminder
# entities and speaks them. Requires SECOND_BRAIN_ENABLED=true.
CRON_ENABLED=false
CRON_POLL_INTERVAL_SECONDS=60

# -------------------------------
# Calendar read reliability
# -------------------------------
CALENDAR_READ_TIMEOUT_SECONDS=10
CALENDAR_READ_RETRY_COUNT=1
CALENDAR_READ_RETRY_DELAY_SECONDS=0.4

# -------------------------------
# Web search rate limiting
# -------------------------------
# Minimum seconds between DuckDuckGo calls to avoid 429 rate-limit errors.
WEB_SEARCH_MIN_INTERVAL_SECONDS=1.0

# -------------------------------
# Telegram bridge (opt-in)
# -------------------------------
# Extends Kage to your iPhone without an iOS app.
# Requires: pip install python-telegram-bot
# 1. Create a bot via @BotFather and paste the token below.
# 2. Set your numeric Telegram chat ID (comma-separated for multiple users).
# 3. Call TelegramBridge(settings, brain.think_text_stream).start() in app_runner.py.
# Leave TELEGRAM_BOT_TOKEN empty to disable (default).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
